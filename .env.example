# --- OpenAI -------------------------------------------------------------
OPENAI_API_KEY=sk-...

# Image model used to set the ad text over the uploaded image.
# Set this to the exact model id your account is provisioned for.
#
# gpt-image-2 is strongly preferred: it is the only model that accepts
# arbitrary WIDTHxHEIGHT output sizes, so requested dimensions can usually be
# hit natively with no resampling. Every other model is limited to
# 1024x1024 / 1536x1024 / 1024x1536, which forces a resample.
#
# Valid: gpt-image-2 | gpt-image-2-2026-04-21 | gpt-image-1.5 |
#        gpt-image-1 | gpt-image-1-mini | chatgpt-image-latest | dall-e-2
OPENAI_IMAGE_MODEL=gpt-image-2

# Text model that reads the image + source text and writes the headline. Must
# support image input and structured outputs. The image model never sees the
# source text -- this model decides the words, and only those words are
# rendered. That is what stops the source text being copied onto the image.
OPENAI_TEXT_MODEL=gpt-5.6

# Default rendering quality: low | medium | high | auto
# Low is cheaper and faster and is usually enough for a text-only overlay.
# Callers can override it per request with the `quality` form field.
OPENAI_IMAGE_QUALITY=low

# Optional: request timeout (seconds) and retry count for the image call.
# Complex edits can take up to ~2 minutes, so keep this generous.
OPENAI_TIMEOUT_SECONDS=180
OPENAI_MAX_RETRIES=2

# --- Upload limits ------------------------------------------------------
# Hard ceiling on the uploaded file, independent of per-platform limits.
MAX_UPLOAD_BYTES=31457280

# --- Server -------------------------------------------------------------
APP_NAME="Ad Text Image Generator"
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=*
